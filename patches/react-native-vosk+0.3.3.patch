+    // ============================================================
+    // AUDIO STATS
+    // ============================================================
+
+    private fun calculateAudioStats(
+        buffer: ByteArray,
+        length: Int
+    ): Pair<Double, Int> {
+
+        var sumSquares = 0.0
+
+        var maxAmplitude = 0
+
+        var samples = 0
+
+        var i = 0
+
+
+        while (
+            i + 1 < length
+        ) {
+
+            val low =
+                buffer[i]
+                    .toInt() and 0xff
+
+
+            val high =
+                buffer[i + 1]
+                    .toInt()
+
+
+            val sample =
+                (high shl 8) or low
+
+
+            val signedSample =
+                if (
+                    sample > 32767
+                ) {
+
+                    sample - 65536
+
+                } else {
+
+                    sample
+                }
+
+
+            val amplitude =
+                abs(signedSample)
+
+
+            if (
+                amplitude >
+                maxAmplitude
+            ) {
+
+                maxAmplitude =
+                    amplitude
+            }
+
+
+            sumSquares +=
+                signedSample.toDouble() *
+                    signedSample.toDouble()
+
+
+            samples++
+
+            i += 2
+        }
+
+
+        if (samples == 0) {
+
+            return Pair(
+                0.0,
+                0
+            )
+        }
+
+
+        val rms =
+            sqrt(
+                sumSquares /
+                    samples
+            )
+
+
+        return Pair(
+            rms,
+            maxAmplitude
+        )
+    }
