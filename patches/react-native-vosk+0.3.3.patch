+    // ============================================================
+    // GRAMMAR
+    // ============================================================
+
+    private fun makeGrammar(
+        grammarArray: ReadableArray
+    ): String {
+
+        return grammarArray
+            .toArrayList()
+            .joinToString(
+                prefix = "[",
+                separator = ", ",
+                transform = {
+
+                    "\"" +
+                        it.toString()
+                            .replace(
+                                "\"",
+                                "\\\""
+                            ) +
+                        "\""
+                },
+                postfix = "]"
+            )
+    }
