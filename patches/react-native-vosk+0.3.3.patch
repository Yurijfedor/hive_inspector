+    // ============================================================
+    // SAFE STOP
+    // ============================================================
+
+    private fun stopRecognitionLocked() {
+
+        if (stopping) {
+            return
+        }
+
+
+        if (
+            !isListening &&
+            audioRecord == null &&
+            recognitionThread == null
+        ) {
+
+            stopBluetoothCommunication()
+
+            return
+        }
+
+
+        println(
+            "$TAG ========================================"
+        )
+
+        println(
+            "$TAG STOPPING RECOGNITION"
+        )
+
+        println(
+            "$TAG ========================================"
+        )
+
+
+        stopping = true
+
+        isListening = false
+
+
+        // ============================================================
+        // STOP AUDIO RECORD
+        // ============================================================
+
+        val record =
+            audioRecord
+
+
+        if (record != null) {
+
+            try {
+
+                if (
+                    record.recordingState ==
+                    AudioRecord.RECORDSTATE_RECORDING
+                ) {
+
+                    println(
+                        "$TAG Stopping AudioRecord"
+                    )
+
+                    record.stop()
+                }
+
+            } catch (e: Exception) {
+
+                println(
+                    "$TAG AudioRecord.stop ERROR: " +
+                        e.message
+                )
+            }
+        }
+
+
+        // ============================================================
+        // WAIT FOR THREAD
+        // ============================================================
+
+        val thread =
+            recognitionThread
+
+
+        if (thread != null) {
+
+            if (
+                Thread.currentThread() !== thread
+            ) {
+
+                try {
+
+                    println(
+                        "$TAG Waiting for recognition thread"
+                    )
+
+                    thread.join(
+                        STOP_TIMEOUT_MS
+                    )
+
+                } catch (e: InterruptedException) {
+
+                    println(
+                        "$TAG Thread join interrupted"
+                    )
+
+                    Thread.currentThread()
+                        .interrupt()
+                }
+            }
+
+
+            if (thread.isAlive) {
+
+                println(
+                    "$TAG WARNING: recognition thread " +
+                        "did not stop in time"
+                )
+
+            } else {
+
+                println(
+                    "$TAG Recognition thread stopped"
+                )
+            }
+        }
+
+
+        recognitionThread = null
+
+
+        // ============================================================
+        // RELEASE AUDIO RECORD
+        // ============================================================
+
+        val recordToRelease =
+            audioRecord
+
+
+        audioRecord = null
+
+
+        if (recordToRelease != null) {
+
+            try {
+
+                println(
+                    "$TAG Releasing AudioRecord"
+                )
+
+                recordToRelease.release()
+
+            } catch (e: Exception) {
+
+                println(
+                    "$TAG AudioRecord.release ERROR: " +
+                        e.message
+                )
+            }
+        }
+
+
+        // ============================================================
+        // CLOSE RECOGNIZER
+        // ============================================================
+
+        val recognizerToClose =
+            recognizer
+
+
+        recognizer = null
+
+
+        if (recognizerToClose != null) {
+
+            try {
+
+                println(
+                    "$TAG Closing Recognizer"
+                )
+
+                recognizerToClose.close()
+
+            } catch (e: Exception) {
+
+                println(
+                    "$TAG Recognizer.close ERROR: " +
+                        e.message
+                )
+            }
+        }
+
+
+        // ============================================================
+        // BLUETOOTH
+        // ============================================================
+
+        stopBluetoothCommunication()
+
+
+        stopping = false
+
+
+        println(
+            "$TAG ========================================"
+        )
+
+        println(
+            "$TAG RECOGNITION STOPPED"
+        )
+
+        println(
+            "$TAG ========================================"
+        )
+    }
