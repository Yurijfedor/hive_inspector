+    // ============================================================
+    // MODERN BLUETOOTH ROUTING
+    // Android 12 / API 31+
+    // ============================================================
+
+    private fun prepareModernBluetoothCommunication(
+        bluetoothInput: AudioDeviceInfo
+    ) {
+
+        println(
+            "$TAG ========================================"
+        )
+
+        println(
+            "$TAG MODERN BLUETOOTH ROUTING"
+        )
+
+        println(
+            "$TAG API 31+"
+        )
+
+        println(
+            "$TAG ========================================"
+        )
+
+
+        try {
+
+            val communicationDevices =
+                audioManager
+                    .availableCommunicationDevices
+
+
+            println(
+                "$TAG Available communication devices: " +
+                    communicationDevices.size
+            )
+
+
+            var communicationDevice:
+                AudioDeviceInfo? = null
+
+
+            for (device in communicationDevices) {
+
+                println(
+                    "$TAG COMM DEVICE: " +
+                        "id=${device.id}, " +
+                        "type=${device.type}, " +
+                        "sink=${device.isSink}, " +
+                        "source=${device.isSource}, " +
+                        "name=${device.productName}"
+                )
+
+
+                /*
+                 * Prefer the Bluetooth communication device.
+                 *
+                 * setCommunicationDevice() requires
+                 * a sink/output device.
+                 *
+                 * Android automatically selects the
+                 * corresponding microphone/source.
+                 */
+
+                if (
+                    device.type ==
+                    AudioDeviceInfo.TYPE_BLUETOOTH_SCO
+                ) {
+
+                    communicationDevice = device
+                    break
+                }
+
+
+                if (
+                    Build.VERSION.SDK_INT >=
+                    Build.VERSION_CODES.S
+                ) {
+
+                    if (
+                        device.type ==
+                        AudioDeviceInfo.TYPE_BLE_HEADSET
+                    ) {
+
+                        communicationDevice = device
+                    }
+                }
+            }
+
+
+            if (communicationDevice == null) {
+
+                println(
+                    "$TAG No Bluetooth communication device available"
+                )
+
+                println(
+                    "$TAG AudioRecord will use preferred input routing"
+                )
+
+                return
+            }
+
+
+            println(
+                "$TAG Selecting communication device:"
+            )
+
+            println(
+                "$TAG id=${communicationDevice.id}"
+            )
+
+            println(
+                "$TAG type=${communicationDevice.type}"
+            )
+
+            println(
+                "$TAG name=${communicationDevice.productName}"
+            )
+
+
+            val result =
+                audioManager.setCommunicationDevice(
+                    communicationDevice
+                )
+
+
+            println(
+                "$TAG setCommunicationDevice()=$result"
+            )
+
+
+            if (!result) {
+
+                println(
+                    "$TAG WARNING: Android rejected communication device"
+                )
+
+                return
+            }
+
+
+            val active =
+                audioManager.communicationDevice
+
+
+            if (active != null) {
+
+                println(
+                    "$TAG ACTIVE COMMUNICATION DEVICE:"
+                )
+
+                println(
+                    "$TAG id=${active.id}"
+                )
+
+                println(
+                    "$TAG type=${active.type}"
+                )
+
+                println(
+                    "$TAG name=${active.productName}"
+                )
+
+            } else {
+
+                println(
+                    "$TAG ACTIVE COMMUNICATION DEVICE=null"
+                )
+            }
+
+
+        } catch (e: SecurityException) {
+
+            println(
+                "$TAG Modern Bluetooth routing permission ERROR: " +
+                    e.message
+            )
+
+            println(
+                "$TAG Falling back to AudioRecord preferred input"
+            )
+
+        } catch (e: IllegalArgumentException) {
+
+            println(
+                "$TAG Modern Bluetooth routing invalid device: " +
+                    e.message
+            )
+
+        } catch (e: Exception) {
+
+            println(
+                "$TAG Modern Bluetooth routing ERROR: " +
+                    "${e.javaClass.simpleName}: " +
+                    e.message
+            )
+        }
+    }
