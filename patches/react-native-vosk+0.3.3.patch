+    // ============================================================
+    // JSON
+    // ============================================================
+
+    private fun parseText(
+        hypothesis: String?,
+        key: String
+    ): String? {
+
+        if (
+            hypothesis.isNullOrBlank()
+        ) {
+
+            return null
+        }
+
+
+        return try {
+
+            val json =
+                JSONObject(
+                    hypothesis
+                )
+
+
+            if (
+                !json.has(key)
+            ) {
+
+                null
+
+            } else {
+
+                json.getString(key)
+            }
+
+        } catch (_: Exception) {
+
+            null
+        }
+    }
