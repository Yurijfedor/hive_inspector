+                                    "onPartialResult",
+                                    text
+                                )
+                            }
+                        }
+
+
+                    } catch (e: Exception) {
+
+                        if (!stopping) {
+
+                            println(
+                                "$TAG Recognizer ERROR: " +
+                                    "${e.javaClass.simpleName}: " +
+                                    e.message
+                            )
+
+
+                            sendEvent(
+                                "onError",
+                                e.toString()
+                            )
+                        }
+
+
+                        break
+                    }
+                }
+
+
+            } catch (e: Exception) {
+
+                if (!stopping) {
+
+                    println(
+                        "$TAG Recognition thread ERROR: " +
+                            "${e.javaClass.simpleName}: " +
+                            e.message
+                    )
+
+
+                    sendEvent(
+                        "onError",
+                        e.toString()
+                    )
+                }
+
+
+            } finally {
+
+                println(
+                    "$TAG ========================================"
+                )
+
+                println(
+                    "$TAG RECOGNITION THREAD FINISHED"
+                )
+
+                println(
+                    "$TAG ========================================"
+                )
+            }
+        }
+    }
