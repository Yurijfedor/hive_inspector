+    private fun findBluetoothInputDevice():
+        AudioDeviceInfo? {
+
+        if (
+            Build.VERSION.SDK_INT <
+            Build.VERSION_CODES.M
+        ) {
+            return null
+        }
+
+
+        return try {
+
+            val devices =
+                audioManager.getDevices(
+                    AudioManager.GET_DEVICES_INPUTS
+                )
+
+
+            println(
+                "$TAG Available INPUT devices: " +
+                    devices.size
+            )
+
+
+            for (device in devices) {
+
+                println(
+                    "$TAG INPUT: " +
+                        "id=${device.id}, " +
+                        "type=${device.type}, " +
+                        "name=${device.productName}"
+                )
+
+
+                if (
+                    device.type ==
+                    AudioDeviceInfo.TYPE_BLUETOOTH_SCO
+                ) {
+
+                    println(
+                        "$TAG BLUETOOTH_SCO INPUT FOUND"
+                    )
+
+                    return device
+                }
+
+
+                /*
+                 * Android 12+ / newer Bluetooth LE headsets.
+                 *
+                 * We don't use these as the communication
+                 * device directly here. AudioManager chooses
+                 * the matching source after communication
+                 * routing is selected.
+                 */
+                if (
+                    Build.VERSION.SDK_INT >=
+                    Build.VERSION_CODES.S
+                ) {
+
+                    if (
+                        device.type ==
+                        AudioDeviceInfo.TYPE_BLE_HEADSET
+                    ) {
+
+                        println(
+                            "$TAG BLE HEADSET INPUT FOUND"
+                        )
+
+                        return device
+                    }
+                }
+            }
+
+
+            null
+
+        } catch (e: SecurityException) {
+
+            println(
+                "$TAG Bluetooth INPUT permission ERROR: " +
+                    e.message
+            )
+
+            null
+
+        } catch (e: Exception) {
+
+            println(
+                "$TAG findBluetoothInputDevice ERROR: " +
+                    e.message
+            )
+
+            null
+        }
+    }
